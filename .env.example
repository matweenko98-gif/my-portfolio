# Public Supabase configuration (use a publishable/anon key, never service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Telegram configuration. Set these in Vercel and .env.local.
# Rotate any bot token that was previously included in a VITE_ variable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
